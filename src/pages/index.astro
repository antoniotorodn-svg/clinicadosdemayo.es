---
import Layout from '../layouts/Layout.astro';
import WhatsAppLink from '../components/WhatsAppLink.astro';
import Icon from '../components/Icon.astro';
import CtaFinal from '../components/CtaFinal.astro';
import ResenasGrid from '../components/ResenasGrid.astro';
const treatments = [
 {n:'01',title:'Quiropodia',text:'Cuidado de durezas, callos y otras molestias habituales de los pies.',url:'/quiropodia'},
 {n:'02',title:'Uñas encarnadas',text:'Valoración y tratamiento de la uña y las molestias que provoca.',url:'/unas-encarnadas-mostoles'},
 {n:'03',title:'Estudio de la pisada',text:'Análisis biomecánico para conocer cómo apoyas y caminas.',url:'/estudio-biomecanico-mostoles'},
 {n:'04',title:'Plantillas a medida',text:'Ortopodología y plantillas personalizadas para adultos y niños.',url:'/plantillas-ortopedicas-mostoles'},
 {n:'05',title:'Cirugía del pie',text:'Valoración de patologías del pie y cirugía percutánea MIS.',url:'/cirugia-pie-mostoles'},
 {n:'06',title:'Podología deportiva',text:'Atención a las necesidades del pie relacionadas con el deporte.',url:'/podologia-deportiva-mostoles'},
];
const schema = JSON.stringify({'@context':'https://schema.org','@type':'MedicalClinic','@id':'https://clinicadosdemayo.com/#business','name':'Clínica Dos de Mayo','telephone':'+34916146770','url':'https://clinicadosdemayo.com','address':{'@type':'PostalAddress','streetAddress':'Calle Soria 2','addressLocality':'Móstoles','postalCode':'28934','addressRegion':'Madrid','addressCountry':'ES'},'medicalSpecialty':'Podiatry','openingHours':['Mo-Tu 09:30-19:00','We 09:30-19:30','Th-Fr 09:30-13:30']});
---
<Layout title="Clínica Dos de Mayo | Podología en Móstoles | Pide tu cita" description="Cuidado de tus pies en Clínica Dos de Mayo, Móstoles. Quiropodia, estudio de la pisada, plantillas y cirugía del pie. Pide cita en el 916 14 67 70." canonical="https://clinicadosdemayo.com" schema={schema}>
  <section class="home-hero">
   <div class="container hero-layout">
    <div class="home-hero-copy">
     <p class="eyebrow"><span class="status-dot"></span> PODOLOGÍA EN MÓSTOLES</p>
     <h1>El cuidado de tus pies <em>empieza aquí.</em></h1>
     <p class="hero-intro">Clínica Dos de Mayo. Atención podológica para cuidar de ti, paso a paso.</p>
     <a class="btn btn-cta hero-primary" href="tel:+34916146770"><Icon /><span><strong>Llamar para pedir cita</strong><small>916 14 67 70</small></span><Icon name="arrow" /></a>
     <div class="hero-whatsapp"><WhatsAppLink /></div>
     <div class="hero-details"><Icon name="pin" size={17}/><span>Calle Soria 2, Móstoles</span><a href="#ubicacion">Cómo llegar</a></div>
    </div>
    <div class="hero-photo-wrap">
     <img class="hero-photo" src="/clinica-recepcion.webp" alt="Recepción y sala de espera de la Clínica Dos de Mayo" width="1157" height="660" fetchpriority="high" />
     <div class="photo-caption"><span>TE DAMOS LA BIENVENIDA</span><p>Un espacio para cuidar de tus pies.</p></div>
     <div class="photo-corner"><Icon name="plus" size={24} /></div>
    </div>
   </div>
   <div class="container"><div class="hero-bottom"><span>QUIROPODIA</span><span>CIRUGÍA DEL PIE</span><span>PLANTILLAS A MEDIDA</span><span>ESTUDIO DE LA PISADA</span></div></div>
  </section>

  <section class="home-section treatments" id="tratamientos">
   <div class="container">
    <div class="section-heading"><div><p class="eyebrow">CADA PIE, SU CUIDADO</p><h2>¿En qué podemos ayudarte?</h2></div><p>Desde las molestias del día a día hasta un estudio de la pisada. Encuentra información sobre tu tratamiento.</p></div>
    <div class="treatment-grid">{treatments.map(t=><a class="treatment" href={t.url}><div class="treatment-top"><span>{t.n}</span><Icon name="arrow" size={22}/></div><h3>{t.title}</h3><p>{t.text}</p><span class="treatment-link">Conocer el tratamiento</span></a>)}</div>
    <div class="treatment-other"><p>También atendemos <a href="/papilomas-plantares-mostoles">papilomas</a>, <a href="/pie-diabetico-mostoles">pie diabético</a>, <a href="/juanetes-mostoles">juanetes</a> y <a href="/espolon-calcaneo-mostoles">dolor en el talón</a>.</p><a href="tel:+34916146770">¿Tienes dudas? Llámanos <Icon name="arrow" size={17}/></a></div>
   </div>
  </section>

  <section class="clinic-section" id="clinica">
   <div class="container clinic-layout">
    <div class="clinic-images"><img src="/clinica-consulta.webp" alt="Consulta de podología de la clínica, con sillón verde" width="1132" height="880" loading="lazy"/><div class="clinic-image-label"><Icon name="plus" size={21}/><span>CLÍNICA DOS DE MAYO</span></div></div>
    <div class="clinic-copy"><p class="eyebrow">TU CLÍNICA, DE CERCA</p><h2>Personas que cuidan.<br/>Un lugar al que venir.</h2><p>Queremos que conozcas la clínica antes de tu visita. Esta es nuestra consulta y, en la portada, la recepción donde te damos la bienvenida.</p><div class="clinic-fact"><span>+15</span><p>Años de experiencia en cirugía percutánea MIS del pie.</p></div><p class="clinic-copy-small">Quiropodia, ortopodología, biomecánica y cirugía del pie en Calle Soria 2, Móstoles.</p><a href="tel:+34916146770" class="text-link">Hablemos de tu cita <Icon name="arrow" size={20}/></a></div>
   </div>
  </section>

  <section class="home-section visit-section" id="reserva"><div class="container"><div class="section-heading"><div><p class="eyebrow">CITA POR TELÉFONO, DE PERSONA A PERSONA</p><h2>Tu próxima visita empieza<br/>con una llamada.</h2></div><a class="btn btn-outline" href="tel:+34916146770"><Icon/>916 14 67 70</a></div><div class="steps"><div><span>01</span><h3>Llámanos</h3><p>Cuéntanos qué necesitas y consulta la disponibilidad.</p></div><div><span>02</span><h3>Concreta tu cita</h3><p>Acuerda el día y la hora directamente con la clínica.</p></div><div><span>03</span><h3>Ven a conocernos</h3><p>Te esperamos en Calle Soria 2, Móstoles.</p></div></div></div></section>

  <section class="location-section" id="ubicacion"><div class="container location-layout"><div class="location-copy"><p class="eyebrow">CERCA DE TI, EN MÓSTOLES</p><h2>Nos encontrarás<br/>en Calle Soria.</h2><p class="location-address">Calle Soria 2<br/>28934 Móstoles, Madrid</p><p>Reconocerás la clínica por su fachada y el rótulo de Dos de Mayo.</p><a href="https://maps.google.com/?q=Calle+Soria+2+Mostoles+Madrid" class="text-link" target="_blank" rel="noopener">Abrir indicaciones en Google Maps <Icon name="arrow" size={20}/></a><div class="hours-slot"><span>HORARIO DE LA CLÍNICA</span><dl class="opening-hours"><div><dt>Lunes y martes</dt><dd>9:30–19:00</dd></div><div><dt>Miércoles</dt><dd>9:30–19:30</dd></div><div><dt>Jueves y viernes</dt><dd>9:30–13:30</dd></div><div><dt>Sábado y domingo</dt><dd>Cerrado</dd></div></dl><p>Para festivos y disponibilidad, consulta por teléfono.</p></div></div><figure class="location-photo"><img src="/clinica-fachada.webp" alt="Fachada de Clínica Dos de Mayo y entrada a la derecha" width="1280" height="960" loading="lazy"/><figcaption><Icon name="pin" size={16}/> Calle Soria 2 · Móstoles</figcaption></figure></div></section>
  <ResenasGrid />
  <CtaFinal />
</Layout>

<style>
.home-hero{background:var(--paper);padding-top:44px}.hero-layout{display:grid;grid-template-columns:1fr 1.04fr;gap:64px;align-items:center}.home-hero-copy{padding:20px 0 30px}.home-hero h1{font-size:clamp(48px,4.7vw,68px);line-height:1.055;letter-spacing:-2.2px;margin:25px 0 23px;max-width:570px;font-weight:400}.home-hero h1 em{font-style:normal;color:var(--green)}.hero-intro{font-size:17px;line-height:1.7;max-width:370px;color:var(--muted);margin-bottom:26px}.hero-primary{padding:15px 21px;gap:20px;border-radius:12px;text-align:left}.hero-primary strong{display:block;font-size:15px}.hero-primary small{display:block;font-weight:400;font-size:13px;opacity:.85;margin-top:2px}.hero-whatsapp{margin-top:8px}.hero-details{display:flex;align-items:center;gap:8px;font-size:12px;color:var(--muted);margin-top:20px;flex-wrap:wrap}.hero-details a{margin-left:10px;border-bottom:1px solid #b4beb4;color:var(--green)}.hero-photo-wrap{position:relative;isolation:isolate;margin-top:0}.hero-photo{width:100%;height:505px;object-fit:cover;object-position:56% center;border-radius:120px 20px 20px 20px}.photo-caption{position:absolute;bottom:22px;left:22px;right:22px;border-radius:11px;background:rgba(250,249,246,.95);backdrop-filter:blur(8px);padding:17px 20px}.photo-caption span{font-size:9px;letter-spacing:1.3px;color:var(--green);font-weight:700}.photo-caption p{font-family:'DM Serif Display',Georgia,serif;font-size:20px;margin-top:3px;color:var(--plum)}.photo-corner{position:absolute;top:24px;right:24px;display:grid;place-content:center;width:48px;height:48px;border-radius:50%;background:var(--paper);color:var(--green)}.hero-bottom{display:flex;align-items:center;justify-content:space-between;gap:12px;border-top:1px solid var(--line);margin-top:42px;padding:25px 0;font-size:10px;letter-spacing:1.8px;color:var(--muted);font-weight:600}.hero-bottom span+span::before{content:'+';color:var(--green);margin-right:32px;font-weight:400}
.home-section{padding:100px 0}.section-heading{display:flex;align-items:end;justify-content:space-between;gap:48px;margin-bottom:40px}.section-heading h2{font-size:clamp(34px,3.2vw,46px);font-weight:400;letter-spacing:-1.2px;line-height:1.15;margin-top:16px}.section-heading>p{font-size:15px;color:var(--muted);max-width:300px;line-height:1.8;padding-bottom:3px}.treatment-grid{display:grid;grid-template-columns:repeat(3,1fr);border-left:1px solid var(--line);border-top:1px solid var(--line)}.treatment{border-right:1px solid var(--line);border-bottom:1px solid var(--line);padding:27px 28px 26px;color:var(--ink);transition:background .2s}.treatment:hover{background:var(--green-pale);color:var(--ink)}.treatment-top{display:flex;justify-content:space-between;align-items:center;color:var(--green)}.treatment-top span{font-size:11px;letter-spacing:1px;color:var(--muted)}.treatment h3{font-size:25px;font-weight:400;letter-spacing:-.5px;margin:25px 0 12px}.treatment p{font-size:14px;line-height:1.75;color:var(--muted);max-width:260px;min-height:74px}.treatment-link{font-size:11px;font-weight:600;display:block;margin-top:18px;color:var(--green)}.treatment-other{display:flex;justify-content:space-between;gap:24px;font-size:12px;margin-top:26px;color:var(--muted)}.treatment-other p{max-width:620px}.treatment-other a{color:var(--green);text-decoration:underline;text-underline-offset:3px}.treatment-other>a{display:flex;gap:10px;align-items:center;white-space:nowrap;text-decoration:none;font-weight:600}
.clinic-section{background:var(--green-pale);padding:86px 0}.clinic-layout{display:grid;grid-template-columns:1fr 1fr;gap:90px;align-items:center}.clinic-images{position:relative}.clinic-images>img{height:540px;object-fit:cover;border-radius:16px 16px 90px 16px;width:100%}.clinic-image-label{position:absolute;bottom:25px;left:25px;display:flex;align-items:center;gap:10px;color:var(--plum);background:var(--paper);padding:12px 16px;border-radius:8px;font-size:9px;letter-spacing:1px}.clinic-copy h2{font-size:44px;font-weight:400;letter-spacing:-1.2px;line-height:1.18;margin:20px 0 25px}.clinic-copy>p:not(.eyebrow){font-size:15px;color:var(--muted);line-height:1.9}.clinic-fact{display:flex;gap:26px;align-items:center;border-top:1px solid #c4d0c7;border-bottom:1px solid #c4d0c7;padding:23px 0;margin:28px 0 21px}.clinic-fact>span{font-family:'DM Serif Display',Georgia,serif;color:var(--green);font-size:56px;line-height:1}.clinic-fact p{font-size:13px;max-width:220px;line-height:1.7;color:var(--green)}.clinic-copy .clinic-copy-small{font-size:13px!important}.text-link{display:inline-flex;gap:14px;align-items:center;color:var(--green);font-size:14px;font-weight:600;border-bottom:1px solid #aebfb4;padding-bottom:7px;margin-top:22px}.steps{display:grid;grid-template-columns:repeat(3,1fr);gap:48px;margin-top:55px}.steps>div{border-top:1px solid var(--line);padding-top:22px}.steps span{font-size:12px;color:var(--green)}.steps h3{font-size:26px;font-weight:400;margin:16px 0 12px}.steps p{font-size:14px;line-height:1.8;color:var(--muted);max-width:260px}
.location-section{background:#eeebe6;padding:80px 0}.location-layout{display:grid;grid-template-columns:1fr 1fr;gap:80px;align-items:center}.location-copy h2{font-size:45px;font-weight:400;letter-spacing:-1px;line-height:1.15;margin:20px 0 27px}.location-address{font-size:20px!important;line-height:1.6;color:var(--ink)!important;margin-bottom:18px}.location-copy>p:not(.eyebrow){color:var(--muted);font-size:14px;line-height:1.8;max-width:350px}.location-copy .text-link{font-size:13px}.location-photo{margin:0}.location-photo img{width:100%;aspect-ratio:1.1;object-fit:cover;border-radius:16px}.location-photo figcaption{display:flex;gap:8px;align-items:center;margin-top:14px;color:var(--muted);font-size:12px}.hours-slot{margin-top:28px;border-top:1px solid #d3d0cb;padding-top:20px;max-width:370px}.hours-slot>span{font-size:9px;letter-spacing:1.3px;color:var(--green);font-weight:700}.hours-slot p{font-size:13px;line-height:1.7;color:var(--muted);margin-top:8px}.hours-slot a{color:var(--green);font-weight:600}.opening-hours{margin-top:12px;font-size:12px}.opening-hours>div{display:flex;justify-content:space-between;gap:20px;padding:5px 0}.opening-hours dt{color:var(--muted)}.opening-hours dd{color:var(--ink)}
@media(max-width:1000px){.hero-layout{gap:35px}.home-hero h1{font-size:52px}.hero-photo{height:470px}.clinic-layout{gap:45px}.clinic-copy h2{font-size:36px}.hero-bottom span+span::before{margin-right:15px}.treatment-other{flex-wrap:wrap}}
@media(max-width:800px){.home-hero{padding-top:20px}.hero-layout{grid-template-columns:1fr;gap:28px}.home-hero-copy{padding:12px 0 0}.home-hero h1{font-size:46px;letter-spacing:-1.7px;margin:19px 0 18px;max-width:470px}.hero-intro{font-size:15px;max-width:330px;line-height:1.7;margin-bottom:21px}.hero-primary{width:100%;justify-content:space-between;max-width:420px;min-height:67px;padding:13px 20px}.hero-primary>span{flex:1}.hero-details{font-size:11px;margin-top:16px}.hero-photo{height:325px;border-radius:70px 16px 16px 16px;object-position:center}.photo-caption{left:15px;right:15px;bottom:15px;padding:12px 15px}.photo-caption p{font-size:18px}.photo-corner{top:15px;right:15px;width:40px;height:40px}.hero-bottom{display:grid;grid-template-columns:1fr 1fr;margin-top:25px;padding:22px 0;gap:15px;font-size:8px;letter-spacing:1.1px}.hero-bottom span+span::before{content:none}.home-section{padding:58px 0}.section-heading{display:block;margin-bottom:28px}.section-heading h2{font-size:34px;letter-spacing:-1px}.section-heading>p{max-width:100%;margin-top:20px;font-size:14px}.treatment-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.treatment{padding:19px 17px}.treatment h3{font-size:23px;margin-top:21px;line-height:1.15}.treatment p{font-size:12px;min-height:96px;line-height:1.7}.treatment-link{font-size:10px;margin-top:12px}.treatment-other{display:block;font-size:12px;line-height:1.9;margin-top:20px}.treatment-other>a{margin-top:14px}.clinic-section{padding:50px 0}.clinic-layout{grid-template-columns:1fr;gap:36px}.clinic-images>img{height:340px;border-radius:14px 14px 65px 14px}.clinic-copy h2{font-size:35px;margin-top:17px}.clinic-copy>p:not(.eyebrow){font-size:14px}.clinic-fact{margin:24px 0 20px;padding:20px 0}.clinic-fact>span{font-size:49px}.clinic-fact p{font-size:12px}.visit-section .btn{margin-top:24px}.steps{grid-template-columns:1fr;gap:26px;margin-top:35px}.steps>div{display:grid;grid-template-columns:35px 1fr;column-gap:12px;padding-top:18px}.steps span{grid-row:1/3;padding-top:5px}.steps h3{margin:0 0 7px;font-size:25px}.steps p{max-width:100%;font-size:13px}.location-section{padding:52px 0}.location-layout{grid-template-columns:1fr;gap:32px}.location-copy h2{font-size:35px}.location-photo img{aspect-ratio:4/3}.location-copy .text-link{font-size:12px}}
@media(prefers-reduced-motion:reduce){*{transition:none!important}}
</style>
