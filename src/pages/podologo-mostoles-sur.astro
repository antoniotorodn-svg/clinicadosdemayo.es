---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import TrustBar from '../components/TrustBar.astro';
import CtaFinal from '../components/CtaFinal.astro';
---
<Layout title="Podología en Móstoles - Móstoles Sur | Clínica Dos de Mayo" description="Clínica Dos de Mayo en Calle Soria 2, Móstoles. Información y citas en el 916 14 67 70." canonical="https://clinicadosdemayo-es.vercel.app/podologo-mostoles-sur/">
<Hero title="Podología en Móstoles" subtitle="Información para vecinos de Móstoles Sur" description="Clínica Dos de Mayo está en Calle Soria 2, Móstoles. Contacta para informarte sobre la consulta y pedir cita." />
<TrustBar />
<section class="section"><div class="container brief-content"><h2>Ven a conocernos</h2><p>Consulta nuestros tratamientos y la ubicación de la clínica. Para conocer la disponibilidad, llama al 916 14 67 70 o escríbenos por WhatsApp al mismo número.</p><div class="brief-links"><a href="/#tratamientos">Ver tratamientos</a><a href="/#ubicacion">Ubicación y horario</a></div></div></section>
<CtaFinal />
</Layout>
<style>.brief-content{max-width:800px}.brief-content h2{font-size:clamp(28px,4vw,38px);margin-bottom:24px}.brief-content p{font-size:16px;line-height:1.85;color:var(--muted);margin-bottom:20px}.brief-links{display:flex;gap:24px;flex-wrap:wrap}.brief-links a{color:var(--green);text-decoration:underline;text-underline-offset:4px}</style>
