---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import TrustBar from '../components/TrustBar.astro';
import CtaFinal from '../components/CtaFinal.astro';
const schema = JSON.stringify({"@context": "https://schema.org", "@type": "Service", "name": "Estudio de la pisada en Móstoles", "provider": {"@id": "https://clinicadosdemayo-es.vercel.app/#business"}, "areaServed": {"@type": "City", "name": "Móstoles"}});
---
<Layout title="Estudio de la pisada en Móstoles | Clínica Dos de Mayo" description="Exploración biomecánica de la pisada. Pide cita en el 916 14 67 70." canonical="https://clinicadosdemayo-es.vercel.app/estudio-biomecanico-mostoles/" schema={schema}>
<Hero title="Estudio de la pisada en Móstoles" subtitle="Exploración biomecánica de la pisada." description="La clínica realiza exploración estática, postural y dinámica. Contacta para informarte sobre la consulta y pedir cita." />
<TrustBar />
<section class="section"><div class="container brief-content"><h2>Tu consulta, en Calle Soria 2</h2><p>Para pedir cita o consultar la disponibilidad, llama al 916 14 67 70. También puedes escribirnos por WhatsApp al mismo número.</p><p>La información de esta página es general. La valoración, las opciones de tratamiento y sus condiciones se explican de forma individual en la consulta.</p><a href="/#tratamientos">Ver los tratamientos de la clínica</a></div></section>
<CtaFinal />
</Layout>
<style>.brief-content{max-width:800px}.brief-content h2{font-size:clamp(28px,4vw,38px);margin-bottom:24px}.brief-content p{font-size:16px;line-height:1.85;color:var(--muted);margin-bottom:20px}.brief-content a{color:var(--green);text-decoration:underline;text-underline-offset:4px}</style>
