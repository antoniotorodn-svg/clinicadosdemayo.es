---
import servicios from '../data/servicios.json';
---
<footer class="site-footer"><div class="container"><div class="footer-top"><div><p class="footer-brand">dos de mayo</p><p>Clínica podológica en Móstoles</p><p>Calle Soria 2 · 28934 Móstoles, Madrid</p><a class="footer-phone" href="tel:+34916146770">916 14 67 70</a></div><div><h3>Tu visita</h3><a href="/#clinica">Conoce la clínica</a><a href="/#ubicacion">Cómo llegar</a><a href="tel:+34916146770">Pedir cita por teléfono</a></div><div><h3>Tratamientos</h3>{servicios.slice(0,4).map(s=><a href={s.url}>{s.titulo.replace('Unas encarnadas','Uñas encarnadas').replace('Quiropodia','Quiropodia').replace('Pie diabetico','Pie diabético')}</a>)}</div></div><div class="footer-base"><p>© {new Date().getFullYear()} Clínica Dos de Mayo · FISIOMED 2001 SL · NIF B84605740</p><a href="https://fisiomed2001.com/politica-de-privacidad/">Política de privacidad</a></div></div></footer>
<style>.site-footer{background:#eeeae5;padding:58px 0 24px;font-size:13px;color:var(--muted)}.footer-top{display:grid;grid-template-columns:2fr 1fr 1fr;gap:4rem}.footer-top p{margin-bottom:10px}.footer-brand{font-family:'DM Serif Display',Georgia,serif;font-size:30px;color:var(--plum)}.footer-top h3{font-family:inherit;font-size:13px;font-weight:700;margin:8px 0 18px;color:var(--ink)}.footer-top a{display:block;color:var(--muted);margin:10px 0}.footer-top .footer-phone{font-weight:700;color:var(--green);font-size:19px}.footer-base{display:flex;justify-content:space-between;padding-top:22px;margin-top:42px;border-top:1px solid var(--line);font-size:11px}.footer-base a{color:var(--muted)}@media(max-width:800px){.footer-top{grid-template-columns:1fr 1fr;gap:24px}.footer-top>div:first-child{grid-column:1/-1}.footer-base{gap:15px;align-items:start}.site-footer{padding-top:38px}}</style>