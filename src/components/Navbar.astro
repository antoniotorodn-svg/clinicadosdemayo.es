---
import Icon from './Icon.astro';
---
<header class="site-header">
 <div class="container header-inner">
  <a href="/" class="brand" aria-label="Clínica Dos de Mayo, inicio"><span class="brand-mark">dm<span>+</span></span><span><strong>dos de mayo</strong><small>CLÍNICA PODOLÓGICA · MÓSTOLES</small></span></a>
  <nav class="desktop-nav" aria-label="Navegación principal"><a href="/#tratamientos">Tratamientos</a><a href="/#clinica">La clínica</a><a href="/#ubicacion">Cómo llegar</a></nav>
  <a href="tel:+34916146770" class="header-call" aria-label="Llamar a Clínica Dos de Mayo: 916 14 67 70"><Icon /><span>916 14 67 70</span></a>
 </div>
</header>
<style>
.site-header{position:sticky;top:0;z-index:100;background:rgba(250,249,246,.97);border-bottom:1px solid var(--line)}.header-inner{height:92px;display:flex;align-items:center;justify-content:space-between;gap:2rem}.brand{display:flex;align-items:center;gap:12px;color:var(--ink)}.brand-mark{width:47px;height:47px;position:relative;background:var(--plum);color:white;border-radius:15px 15px 15px 3px;display:grid;place-content:center;font-family:Georgia,serif;font-size:25px;letter-spacing:-3px;padding-right:3px}.brand-mark span{font-size:15px;color:#c6d8c9;position:absolute;right:3px;top:0;letter-spacing:0}.brand strong{display:block;font-size:22px;letter-spacing:-.6px;font-weight:650}.brand small{display:block;font-size:9px;letter-spacing:1.25px;color:var(--muted);margin-top:1px}.desktop-nav{display:flex;gap:28px}.desktop-nav a{font-size:14px;color:var(--ink)}.header-call{display:flex;align-items:center;gap:10px;color:var(--green);font-weight:700;font-size:17px}.header-call svg{width:18px}@media(max-width:800px){.header-inner{height:78px;gap:12px}.desktop-nav{display:none}.brand strong{font-size:20px}.brand small{font-size:7px;letter-spacing:.9px}.brand-mark{width:39px;height:39px;font-size:22px}.header-call span{display:none}.header-call{width:44px;height:44px;justify-content:center;border:1px solid var(--line);border-radius:50%}}
</style>