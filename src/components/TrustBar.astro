---
import Icon from './Icon.astro';
---
<section class="trust-line"><div class="container trust-line-inner"><p><Icon name="pin" size={17}/><span>Calle Soria 2 · Móstoles</span></p><a href="https://www.google.com/search?q=Cl%C3%ADnica+Dos+de+Mayo+Pod%C3%B3logo+M%C3%B3stoles&hl=es" target="_blank" rel="noopener"><strong>4,6/5</strong><span>en Google · 134 reseñas</span><Icon name="arrow" size={16}/></a></div></section>
<style>.trust-line{padding:22px 0;border-bottom:1px solid var(--line)}.trust-line-inner{display:flex;justify-content:space-between;gap:20px;align-items:center}.trust-line p,.trust-line a{display:flex;align-items:center;gap:10px;font-size:12px;color:var(--muted)}.trust-line strong{color:var(--green);font-size:16px}@media(max-width:600px){.trust-line-inner{flex-direction:column;align-items:start;gap:14px}}</style>
