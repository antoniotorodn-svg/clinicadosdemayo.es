---
import Icon from './Icon.astro';
interface Props {title:string;subtitle?:string;location?:string;description?:string;showButtons?:boolean;}
const {title,subtitle,location='Móstoles',description}=Astro.props;
---
<section class="service-hero"><div class="container service-hero-inner"><div><a class="back-link" href="/#tratamientos">Clínica Dos de Mayo / Tratamientos</a><p class="eyebrow">PODOLOGÍA EN {location.toUpperCase()}</p><h1>{title}</h1>{subtitle && <p class="service-subtitle">{subtitle}</p>}{description && <p class="service-desc">{description}</p>}<a class="btn btn-cta" href="tel:+34916146770"><Icon/>Pide tu cita · 916 14 67 70<Icon name="arrow" size={18}/></a><p class="service-address">Calle Soria 2 · Móstoles</p></div><img src="/clinica-consulta.webp" alt="Consulta de podología de Clínica Dos de Mayo" width="1132" height="880" fetchpriority="high"/></div></section>
<style>.service-hero{background:var(--green-pale);padding:45px 0 55px}.service-hero-inner{display:grid;grid-template-columns:1.1fr 1fr;gap:65px;align-items:center}.back-link{font-size:11px;color:var(--muted);display:inline-block;margin-bottom:24px}.service-hero h1{font-size:clamp(36px,4.1vw,56px);letter-spacing:-1.3px;line-height:1.1;margin:18px 0}.service-subtitle{font-size:20px;color:var(--green);margin-bottom:15px}.service-desc{color:var(--muted);font-size:15px;line-height:1.85;margin-bottom:24px}.service-hero img{border-radius:60px 16px 16px 16px;width:100%;height:420px;object-fit:cover}.service-address{margin-top:16px;font-size:12px;color:var(--muted)}.service-hero .btn{font-size:14px;gap:10px;padding:15px 19px}@media(max-width:800px){.service-hero{padding:25px 0 36px}.service-hero-inner{grid-template-columns:1fr;gap:28px}.service-hero h1{font-size:37px}.service-subtitle{font-size:18px}.service-hero img{height:260px}.service-hero .btn{width:100%;font-size:12px}.service-desc{font-size:14px}.back-link{margin-bottom:18px}}
</style>
