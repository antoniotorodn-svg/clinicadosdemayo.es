---
import WhatsAppLink from './WhatsAppLink.astro';
import Icon from './Icon.astro';
---
<div class="mobile-reserve"><a href="tel:+34916146770" class="mobile-call"><Icon /><span><strong>Llamar para pedir cita</strong><small>916 14 67 70</small></span></a><WhatsAppLink compact /></div>
<style>.mobile-reserve{display:none}@media(max-width:800px){.mobile-reserve{position:fixed;bottom:0;left:0;right:0;z-index:110;display:flex;gap:10px;background:#faf9f6;padding:12px 16px calc(12px + env(safe-area-inset-bottom));border-top:1px solid var(--line);box-shadow:0 -4px 20px #2420240a}.mobile-call{flex:1;background:var(--green);color:white;display:flex;align-items:center;justify-content:center;gap:12px;min-height:52px;border-radius:12px}.mobile-call strong{font-size:14px;display:block}.mobile-call small{font-size:12px;display:block;text-align:center;opacity:.85}.mobile-map{width:52px;display:grid;place-content:center;border:1px solid var(--line);border-radius:12px;color:var(--green)}} </style>