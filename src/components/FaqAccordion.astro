---
interface Props {
  faqs: { pregunta: string; respuesta: string }[];
}

const { faqs } = Astro.props;
---
<section class="section" id="faq">
  <div class="container">
    <h2 class="section-title">Preguntas frecuentes</h2>
    <div class="faq-list">
      {faqs.map((faq, i) => (
        <details class="faq-item" open={i === 0}>
          <summary class="faq-question">{faq.pregunta}</summary>
          <div class="faq-answer">
            <p>{faq.respuesta}</p>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq-list {
    max-width: 800px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .faq-item {
    background: var(--white);
    border-radius: var(--radius);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
  }
  .faq-question {
    padding: 1.25rem 1.5rem;
    font-weight: 600;
    font-size: 1.05rem;
    cursor: pointer;
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .faq-question::-webkit-details-marker {
    display: none;
  }
  .faq-question::after {
    content: '+';
    font-size: 1.5rem;
    color: var(--primary);
    flex-shrink: 0;
    margin-left: 1rem;
    transition: transform var(--transition);
  }
  details[open] .faq-question::after {
    content: '-';
  }
  .faq-answer {
    padding: 0 1.5rem 1.25rem;
  }
  .faq-answer p {
    color: var(--text-light);
    line-height: 1.6;
  }
  @media (max-width: 768px) {
    .faq-question {
      padding: 1rem 1.25rem;
      font-size: 0.95rem;
      min-height: 48px;
    }
    .faq-answer {
      padding: 0 1.25rem 1rem;
    }
    .faq-answer p {
      font-size: 0.9rem;
    }
  }
</style>
